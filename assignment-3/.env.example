# Copy this file to .env.local and fill in real values.
# Never commit .env.local — only this .env.example file is tracked.

# Shown to users on the contact page and returned by /api/config.
SUPPORT_EMAIL=support@example.com

# Optional: max characters allowed in the contact form "message" field.
# Used both by /api/config (for the client to know the limit) and by
# the zod schema in lib/validation.ts (for server-side enforcement).
MAX_MESSAGE_LENGTH=500

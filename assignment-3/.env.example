# Copy this file to .env.local and fill in real values.
# Never commit .env.local — only this .env.example file is tracked.

API_BASE_URL=https://api.example.com

# DEEPER P2
# .env.example is meant to be committed to git and is visible to anyone with repo access. 
# A real API key, DB password, or base URL pointing at a private staging environment is a credential; committing it defeats the entire purpose of keeping it in an env var instead of hard-coded. 
# The whole reason env vars exist is to keep secrets out of version control.
